<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>TVRockZoo</AssemblyName>
    <RootNamespace>TsScheduler</RootNamespace>
    <Product>TVRock Zoo</Product>
    <AssemblyTitle>TVRock Zoo</AssemblyTitle>
    <Description>TVRock用 予約・番組表ツール</Description>
    <Version>1.0.25</Version>
    <FileVersion>1.0.25.0</FileVersion>
    <AssemblyVersion>1.0.25.0</AssemblyVersion>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="ReservationUi.js" />
    <EmbeddedResource Include="AiRecommendationUi.js" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3485.44" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />

  </ItemGroup>
<ItemGroup><Compile Include="../Shared/*.cs" Link="Shared/%(Filename)%(Extension)" /></ItemGroup></Project>
